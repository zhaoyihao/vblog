---
// Props interface
interface Props {
  serverURL: string;
  lang?: string;
  dark?: string;
  emoji?: string[];
  meta?: string[];
  requiredMeta?: string[];
  reaction?: boolean;
  pageview?: boolean;
}

const {
  serverURL,
  lang = "zh-CN",
  dark = "html[data-theme-type='dark']",
  emoji = ["https://unpkg.com/@waline/emojis@1.1.0/weibo", "https://unpkg.com/@waline/emojis@1.1.0/bilibili"],
  requiredMeta = ["nick"],
  reaction = false,
  pageview = false,
} = Astro.props;
---

<div id="waline-container"></div>

<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />

<script
  type="module"
  is:inline
  define:vars={{
    serverURL,
    lang,
    dark,
    emoji,
    requiredMeta,
    reaction,
    pageview,
  }}
>
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";

  let walineInstance = null;

  // 销毁
  function destroyWaline() {
    try {
      if (walineInstance) {
        walineInstance.destroy();
        walineInstance = null;
      }
    } catch (e) {}
  }

  // 初始化
  function mountWaline() {
    destroyWaline();

    const container = document.querySelector("#waline-container");
    if (!container) return;

    container.innerHTML = "";

    setTimeout(() => {
      walineInstance = init({
        el: "#waline-container",
        serverURL,
        path: window.location.pathname,
        lang,
        dark,
        emoji,
        meta: ["nick", "mail"],
        requiredMeta: ["nick"],
        reaction,
        pageview,
        locale: {
          nick: ' 昵称(必填)︰',
          mail: ' 邮箱'
        }
      });
    }, 20);
  }

  document.addEventListener("astro:before-swap", destroyWaline);
  document.addEventListener("astro:page-load", mountWaline);

  if (document.readyState === "complete") {
    mountWaline();
  } else {
    window.addEventListener("load", mountWaline);
  }
</script>

<style>
#waline-container {
  margin-top: 2rem;
  margin-bottom: 2rem;
}

/* ============================================== */
/* 🔥 全局强制注入：粉色输入框（绝对能生效） */
/* ============================================== */
@layer reset {
  :global(#waline-container [class*="meta-item"] input),
  :global(#waline-container input[placeholder*="昵称"]),
  :global(#waline-container input[placeholder*="邮箱"]) {
    border: 2px solid #f9a8d4 !important;
    background-color: #fdf2f8 !important;
    border-radius: 8px !important;
    padding: 10px 12px !important;
    font-size: 1rem !important;
    color: #1f2937 !important;
  }

  :global(#waline-container [class*="meta-item"] input:focus) {
    border-color: #f472b6 !important;
    box-shadow: 0 0 0 3px rgba(244, 114, 182, 0.25) !important;
    outline: none !important;
  }
}
</style>

