---
interface Props {
  serverURL: string;
  lang?: string;
  dark?: string;
  emoji?: string[];
  meta?: string[];
  requiredMeta?: string[];
  reaction?: boolean;
  pageview?: boolean;
}

const {
  serverURL,
  lang = "zh-CN",
  dark = "html[data-theme-type='dark']",
  emoji = ["https://unpkg.com/@waline/emojis@1.1.0/weibo", "https://unpkg.com/@waline/emojis@1.1.0/bilibili"],
  requiredMeta = ["nick"],
  reaction = false,
  pageview = false,
} = Astro.props;
---

<div id="waline-container"></div>

<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />

<script
  type="module"
  is:inline
  define:vars={{
    serverURL,
    lang,
    dark,
    emoji,
    requiredMeta,
    reaction,
    pageview,
  }}
>
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";

  let walineInstance = null;

  function destroyWaline() {
    try { walineInstance?.destroy(); walineInstance = null; } catch (e) {}
  }

  // 🔥 全局样式穿透 Shadow DOM
  function addWalineStyle() {
    const style = document.createElement('style');
    style.textContent = `
      /* 标签加大加粗 */
      .wl-meta-item label {
        font-size: 1.2rem !important;
        font-weight: 700 !important;
      }
      /* 粉色输入框 */
      .wl-meta-item input {
        border: 2px solid #f472b6 !important;
        background: #fdf2f8 !important;
        border-radius: 8px !important;
        padding: 10px !important;
      }
      .wl-meta-item input:focus {
        border-color: #ec4899 !important;
        box-shadow: 0 0 0 3px rgba(244,114,182,0.3) !important;
      }
    `;
    document.head.appendChild(style);
  }

  function mountWaline() {
    destroyWaline();
    const container = document.querySelector("#waline-container");
    if (!container) return;
    container.innerHTML = "";

    setTimeout(() => {
      walineInstance = init({
        el: "#waline-container",
        serverURL,
        path: window.location.pathname,
        lang,
        dark,
        emoji,
        meta: ["nick", "mail"],
        requiredMeta: ["nick"],
        reaction,
        pageview,
        locale: { nick: '昵称(必填):', mail: '邮箱' }
      });
    }, 50);
  }

  // 🔥 提前注入样式
  addWalineStyle();
  
  document.addEventListener("astro:before-swap", destroyWaline);
  document.addEventListener("astro:page-load", mountWaline);
  window.addEventListener("load", () => {
    addWalineStyle();
    mountWaline();
  });
</script>

<style>
#waline-container {
  margin-top: 2rem;
  margin-bottom: 2rem;
}
</style>
