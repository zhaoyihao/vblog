---
// Props interface
interface Props {
  serverURL: string;
  lang?: string;
  dark?: string;
  emoji?: string[];
  meta?: string[];
  requiredMeta?: string[];
  reaction?: boolean;
  pageview?: boolean;
}

const {
  serverURL,
  lang = "zh-CN",
  dark = "html[data-theme-type='dark']",
  emoji = ["https://unpkg.com/@waline/emojis@1.1.0/weibo", "https://unpkg.com/@waline/emojis@1.1.0/bilibili"],
  requiredMeta = ["nick"],
  reaction = false,
  pageview = false,
} = Astro.props;
---

<div id="waline-container"></div>

<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />

<script
  type="module"
  is:inline
  define:vars={{
    serverURL,
    lang,
    dark,
    emoji,
    requiredMeta,
    reaction,
    pageview,
  }}
>
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";

  let walineInstance = null;

  // 销毁
  function destroyWaline() {
    try {
      if (walineInstance) {
        walineInstance.destroy();
        walineInstance = null;
      }
    } catch (e) {}
  }

  // 初始化
  function mountWaline() {
    destroyWaline();

    const container = document.querySelector("#waline-container");
    if (!container) return;

    container.innerHTML = "";

    setTimeout(() => {
      walineInstance = init({
        el: "#waline-container",
        serverURL,
        path: window.location.pathname,
        lang,
        dark,
        emoji,
        meta: ["nick", "mail"],
        requiredMeta: ["nick"],
        reaction,
        pageview,
        locale: {
          nick: ' 昵称(必填)︰',
          mail: ' 邮箱'
        }
      });
    }, 20);
  }

  document.addEventListener("astro:before-swap", destroyWaline);
  document.addEventListener("astro:page-load", mountWaline);

  if (document.readyState === "complete") {
    mountWaline();
  } else {
    window.addEventListener("load", mountWaline);
  }
</script>

<style>
#waline-container {
  margin-top: 2rem;
  margin-bottom: 2rem;
}

/* 🔥 强制粉色输入框（核心生效代码） */
#waline-container .wl-comment-form .wl-meta-item input {
  border: 2px solid #ec4899 !important; /* 粉色边框 */
  border-radius: 0.5rem !important;
  background-color: transparent !important;
  color: inherit !important;
  padding: 0.5rem 0.75rem !important;
}

/* 聚焦时边框更亮 */
#waline-container .wl-comment-form .wl-meta-item input:focus {
  outline: none !important;
  border-color: #f472b6 !important; /* 亮粉色 */
  box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.3) !important;
}
</style>
