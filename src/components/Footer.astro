import { USER_NAME, USER_SITE, USER_FOOTER_SOCIAL_ICONS, SITE_ICP, SITE_ICP_LINK } from "@config";
---

<footer class="footer bg-base-100 py-2 px-4 md:p-10 rounded-xl shadow-lg gap-y-2 md:gap-4">
  <aside>
    <p class="text-xs md:text-base">
      Powered by RyuChan Template Copyright ©  KoBariDev  2025–{new Date().getFullYear()} All rights reserved
    </p>

    <div class="mt-1 text-xs md:text-sm flex items-center gap-3">
      <span class="font-bold">{SITE_ICP}</span>
      <a href="/rss.xml" aria-label="RSS Feed" class="text-xs">RSS Feed</a>
    </div>
  </aside>
</footer>
