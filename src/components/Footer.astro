<div class="tooltip" data-tip="RSS 订阅">
  <button 
    id="rssBtn"
    class="text-3xl md:text-4xl text-pink-500 hover:text-pink-600 hover:shadow-[0_0_8px_#ec4899] transition-all"
    aria-label="打开 RSS 订阅菜单"
  >
    <Icon name="ri:rss-line" />
  </button>
</div>

<!-- 订阅菜单（默认隐藏） -->
<div id="rssMenu" class="hidden fixed bottom-16 right-4 bg-base-100 p-4 rounded-xl shadow-xl border border-gray-700 z-50 w-64">
  <p class="text-sm font-medium mb-2">订阅到阅读器</p>
  <ul class="space-y-2 text-sm">
    <li>
      <a href="web+feed:${location.origin}/rss.xml" class="block hover:text-blue-400">
        🔗 默认阅读器
      </a>
    </li>
    <li>
      <a href="https://feedly.com/i/subscription/feed/${encodeURIComponent(location.origin + '/rss.xml')}" target="_blank" rel="noopener" class="block hover:text-blue-400">
        📰 Feedly
      </a>
    </li>
    <li>
      <button id="copyRssLink" class="block w-full text-left hover:text-blue-400">
        📋 复制订阅链接
      </button>
    </li>
  </ul>
</div>

<script is:inline>
  // 菜单开关
  const rssBtn = document.getElementById('rssBtn');
  const rssMenu = document.getElementById('rssMenu');
  const copyBtn = document.getElementById('copyRssLink');

  rssBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    rssMenu?.classList.toggle('hidden');
  });

  // 点击页面其他地方关闭菜单
  document.addEventListener('click', () => {
    rssMenu?.classList.add('hidden');
  });

  // 复制链接
  copyBtn?.addEventListener('click', () => {
    const url = `${location.origin}/rss.xml`;
    navigator.clipboard.writeText(url).then(() => {
      copyBtn.textContent = '✅ 已复制';
      setTimeout(() => copyBtn.textContent = '📋 复制订阅链接', 2000);
    });
  });
</script>
