---
// 1. 导入布局（必须导入，否则构建失败）
import BaseLayout from "@layouts/BaseLayout.astro";

// 2. 只做旧域名跳转（单逻辑，无死循环）
if (Astro.url.host === 'vblog-u5u.pages.dev') {
  return Astro.redirect(`https://wdblog.cc.cd${Astro.url.pathname}`, 301);
}
---

<!-- 3. 正常的首页内容（必须写，否则是空页面构建报错） -->
<BaseLayout title="首页">
  <div class="container mx-auto p-6">
    <h1 class="text-3xl font-bold text-center mb-4">欢迎来到我的博客</h1>
    <p class="text-center">网站已正常运行 🚀</p>
  </div>
</BaseLayout>
